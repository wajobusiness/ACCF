{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/members/[id]",
      "regex": "^/members/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/members/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/auth/login",
      "regex": "^/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/login(?:/)?$"
    },
    {
      "page": "/business",
      "regex": "^/business(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/business(?:/)?$"
    },
    {
      "page": "/community",
      "regex": "^/community(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/community(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/festival",
      "regex": "^/festival(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/festival(?:/)?$"
    },
    {
      "page": "/kolanut-tree",
      "regex": "^/kolanut\\-tree(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kolanut\\-tree(?:/)?$"
    },
    {
      "page": "/marketplace",
      "regex": "^/marketplace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/marketplace(?:/)?$"
    },
    {
      "page": "/media",
      "regex": "^/media(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/media(?:/)?$"
    },
    {
      "page": "/meet-and-eat",
      "regex": "^/meet\\-and\\-eat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/meet\\-and\\-eat(?:/)?$"
    },
    {
      "page": "/membership",
      "regex": "^/membership(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership(?:/)?$"
    },
    {
      "page": "/membership/checkout",
      "regex": "^/membership/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership/checkout(?:/)?$"
    },
    {
      "page": "/partnerships",
      "regex": "^/partnerships(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/partnerships(?:/)?$"
    },
    {
      "page": "/peace-table",
      "regex": "^/peace\\-table(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/peace\\-table(?:/)?$"
    },
    {
      "page": "/peace-wall",
      "regex": "^/peace\\-wall(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/peace\\-wall(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}